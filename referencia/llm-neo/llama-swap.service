[Unit]
Description=SIP tiny LLM (llama-swap + llama-server, Fase 4)
Documentation=https://github.com/mostlygeek/llama-swap
After=local-fs.target
# Sin dependencia de red: escucha solo en 127.0.0.1

[Service]
Type=simple
User=sip-llm
Group=sip-llm
ExecStart=/var/lib/sip-llm/bin/llama-swap --config /var/lib/sip-llm/llama-swap.yaml --listen 127.0.0.1:11434
Restart=on-failure
RestartSec=5
# Hardening
NoNewPrivileges=true
ProtectHome=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/sip-llm

[Install]
WantedBy=multi-user.target
