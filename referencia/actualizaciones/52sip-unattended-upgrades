// SIP v2.4 Fase 9 (Neo, Linux Mint 22.3 sobre Ubuntu noble): solo parches de seguridad de Ubuntu.
// El 50unattended-upgrades del paquete usa ${distro_id}=Linuxmint; se vacían sus listas para que
// nada de Mint ni de repositorios de terceros (Docker, NVIDIA, Kopia...) se actualice solo.
#clear Unattended-Upgrade::Allowed-Origins;
#clear Unattended-Upgrade::Origins-Pattern;
#clear Unattended-Upgrade::Package-Blacklist;

Unattended-Upgrade::Origins-Pattern {
    "origin=Ubuntu,archive=noble-security";
};

// Excluidos aunque lleguen por seguridad: núcleo y driver NVIDIA (exigen reinicio y han dado
// desajustes de driver), y Docker (reiniciarlo para todos los servicios). Van al informe semanal.
Unattended-Upgrade::Package-Blacklist {
    "linux-";
    ".*nvidia.*";
    "docker";
    "containerd";
};

Unattended-Upgrade::Automatic-Reboot "false";
Unattended-Upgrade::Remove-Unused-Dependencies "false";
Unattended-Upgrade::Remove-New-Unused-Dependencies "false";
