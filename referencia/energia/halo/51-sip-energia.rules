// Apagado de HALO (05-11): sip-energia (orden fija por SSH desde Neo) arranca SOLO estas tres unidades
// oneshot de root, que comprueban por sí mismas si procede apagar. Nada más.
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" && subject.user == "sip-energia") {
        var unidad = action.lookup("unit");
        if ((unidad == "sip-actividad.service" || unidad == "sip-apagar-auto.service" ||
             unidad == "sip-apagar-usuario.service") && action.lookup("verb") == "start") {
            return polkit.Result.YES;
        }
    }
});
