[Unit]
Description=SIP llama-swap + llama-server en HALO (sustituye a Ollama, 05-11)
Documentation=https://github.com/mostlygeek/llama-swap
After=network-online.target tailscaled.service
Wants=network-online.target
# Mismo puerto y dirección que Ollama: no pueden correr a la vez
Conflicts=ollama.service

[Service]
Type=simple
User=sip-llm
Group=sip-llm
SupplementaryGroups=render video
# Escucha en la IP de la tailnet (como OLLAMA_HOST): espera a que exista, como sip-whisper
ExecStartPre=/bin/sh -c 'for i in $(seq 120); do ip -4 a show tailscale0 | grep -q "inet ${HALO_TAILNET_IP}/" && exit 0; sleep 2; done; exit 1'
ExecStart=/var/lib/sip-llm/bin/llama-swap --config /var/lib/sip-llm/llama-swap.yaml --listen ${HALO_TAILNET_IP}:11434
Restart=on-failure
RestartSec=5
WorkingDirectory=/var/lib/sip-llm
Environment=HOME=/var/lib/sip-llm/cache
# Caché de shaders de Mesa/RADV (acelera las cargas siguientes)
Environment=XDG_CACHE_HOME=/var/lib/sip-llm/cache
# Hardening (la GPU necesita /dev/dri y /dev/kfd: sin PrivateDevices)
NoNewPrivileges=true
ProtectHome=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/sip-llm/cache
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=
LimitMEMLOCK=infinity

[Install]
WantedBy=multi-user.target
