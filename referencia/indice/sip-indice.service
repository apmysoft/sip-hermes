[Unit]
Description=SIP: índice de texto completo de PARA (solo lectura; libros solo por nombre)
ConditionPathIsMountPoint=${PARA_ROOT}

[Service]
Type=oneshot
User=sip-indice
Group=sip-indice
SupplementaryGroups=hermes-ro
UMask=0027
ExecStart=/usr/local/sbin/sip-indice.py --max-minutos 85 --max-paginas-pdf 100 --sin-ocr
Nice=19
IOSchedulingClass=idle
CPUQuota=200%
MemoryMax=3G
# 10-11: recorrer PARA (489.000 ficheros en HDD) ya tarda ~100 min sin nada que indexar; --max-minutos limita la extracción.
TimeoutStartSec=150min
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
ReadWritePaths=/var/lib/sip-indice
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
