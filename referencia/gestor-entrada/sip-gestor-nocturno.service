[Unit]
Description=SIP Gestor de Entrada — barrido nocturno en horas valle (Fase 9)
After=llama-swap.service
# Igual que sip-gestor-entrada.service (Nivel 1: solo propone), pero se salta si ya hay lotes sin decidir.

[Service]
Type=oneshot
User=sip-gestor
Group=sip-gestor
ExecCondition=/usr/local/bin/gestor-nocturno-check.py
ExecStart=/usr/local/bin/gestor-entrada.py scan
# Hardening
NoNewPrivileges=true
ProtectHome=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/sip-gestor-entrada ${STAGING_ROOT}/_staging/_informes
