[Unit]
Description=SIP Gestor de Entrada — scan (Fase 4, Nivel 1)
Documentation=https://github.com/usuario/sip-inventario
# Bajo demanda (sin timer): systemctl start sip-gestor-entrada.service
# Nivel 1: solo propone; nada se mueve sin approved=true en el .json del lote.

[Service]
Type=oneshot
User=sip-gestor
Group=sip-gestor
ExecStart=/usr/local/bin/gestor-entrada.py scan
# Hardening
NoNewPrivileges=true
ProtectHome=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/sip-gestor-entrada ${STAGING_ROOT}/_staging/_informes

# Sin [Install] (04-11): bajo demanda (puente, a mano). Habilitada desde el 28-10, escaneaba en cada
# arranque de Neo (lote-20261104-112531). El barrido nocturno usa su propia unidad.
